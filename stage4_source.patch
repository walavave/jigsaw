+    def test_contact_at_one_corner_does_not_count_as_shared_side(self):
+        a = np.array([[0, 0], [10, 0], [10, 10], [0, 10]], float)
+        b = a + [10, 10]
+        self.assertEqual(shared_edge_length(a, b, 0.5), 0)
+        b = a + [10, 0]
+        self.assertAlmostEqual(shared_edge_length(a, b, 0.5), 10)
