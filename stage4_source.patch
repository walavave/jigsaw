+        # Original first rectangle center (5,4) -> (8-4,5).
+        slot = next(p for p in plan["slot"] if p["scan_piece_id"] == "S01")
+        np.testing.assert_allclose(slot["target_center_px"], [4, 5])
+        self.assertAlmostEqual(slot["rotation_deg"], 60)
